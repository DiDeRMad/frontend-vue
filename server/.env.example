# Database
DATABASE_URL="postgresql://username:password@localhost:5432/epic_mmorpg?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRE=7d

# Session
SESSION_SECRET=your-super-secret-session-key-change-this

# Cors
CORS_ORIGIN=http://localhost:5173

# Sentry (optional)
SENTRY_DSN=

# Email (for password reset, etc)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@epicmmorpg.com

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=epic-mmorpg-assets

# Game Configuration
WORLD_TICK_RATE=50
MAX_PLAYERS_PER_INSTANCE=5000
INSTANCE_CLEANUP_INTERVAL=3600000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Premium Features
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Discord Integration (optional)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_WEBHOOK_URL=

# Monitoring
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# Cache TTL (seconds)
CACHE_TTL_PLAYER=300
CACHE_TTL_CHARACTER=600
CACHE_TTL_ZONE=3600
CACHE_TTL_ITEM=86400