{
  "name": "@mmorpg/server",
  "version": "1.0.0",
  "description": "MMORPG Game Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "migrate": "knex migrate:latest",
