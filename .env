# Server Configuration
NODE_ENV=development
PORT=3000
SERVER_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/eternal-realms
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://user:password@localhost:5432/eternal-realms

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d
SESSION_SECRET=your-session-secret-key-change-in-production
ENCRYPTION_KEY=your-encryption-key-32-characters

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=eternal-realms-assets

# Payment Processing
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Game Configuration
MAX_PLAYERS_PER_SERVER=1000
WORLD_TICK_RATE=20
PHYSICS_TICK_RATE=60
AI_UPDATE_RATE=10

# Analytics & Monitoring
SENTRY_DSN=your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-new-relic-key
GOOGLE_ANALYTICS_ID=your-ga-id

# CDN Configuration
CDN_URL=https://cdn.eternal-realms.com
ASSET_VERSION=1.0.0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket Configuration
WS_PORT=3001
WS_PING_INTERVAL=30000
WS_PING_TIMEOUT=5000

# Cache Configuration
CACHE_TTL=3600
CACHE_CHECK_PERIOD=600

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Feature Flags
ENABLE_PVP=true
ENABLE_TRADING=true
ENABLE_GUILDS=true
ENABLE_VOICE_CHAT=false
ENABLE_AR_MODE=false
MAINTENANCE_MODE=false