    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "redis": "^4.6.12",
    "bull": "^4.12.0",
    "node-cron": "^3.0.3",
